# QC_SANITIZER: none | undefined | thread (set by build.sh)
set(QC_SANITIZER "none" CACHE STRING "sanitizer: none|undefined|thread")

# Applies warnings, sanitizer flags and Threads to a target (never -ffast-math / -march=native).
function(qc_target_defaults tgt)
  get_target_property(_type ${tgt} TYPE)
  set(_vis PRIVATE)
  if(_type STREQUAL "INTERFACE_LIBRARY")
    set(_vis INTERFACE)
  endif()
  target_compile_options(${tgt} ${_vis} -Wall -Wextra -Wpedantic -Wshadow -Werror -ffp-contract=off)
  if(QC_SANITIZER STREQUAL "undefined")
    target_compile_options(${tgt} ${_vis} -fsanitize=undefined -fno-sanitize-recover=all)
    target_link_options(${tgt} ${_vis} -fsanitize=undefined -fno-sanitize-recover=all)
  elseif(QC_SANITIZER STREQUAL "thread")
    target_compile_options(${tgt} ${_vis} -fsanitize=thread)
    target_link_options(${tgt} ${_vis} -fsanitize=thread)
  endif()
  target_link_libraries(${tgt} ${_vis} Threads::Threads)
endfunction()

# qc_add_test(name src labels [extra_libs...]) : name e.g. ofl.test_book.
# Builds one executable, links qc_test_main + qc + the project lib named by the prefix (if such a target exists),
# registers one ctest test with WORKING_DIRECTORY = CMAKE_BINARY_DIR. labels is a ;-list.
function(qc_add_test name src labels)
  string(REPLACE "." "_" _exe ${name})
  string(REGEX REPLACE "\\..*$" "" _proj ${name})
  add_executable(${_exe} ${src})
  qc_target_defaults(${_exe})
  target_link_libraries(${_exe} PRIVATE qc_test_main qc)
  if(NOT _proj STREQUAL "common" AND TARGET ${_proj})
    target_link_libraries(${_exe} PRIVATE ${_proj})
  endif()
  foreach(_l IN LISTS ARGN)
    target_link_libraries(${_exe} PRIVATE ${_l})
  endforeach()
  add_test(NAME ${name} COMMAND ${_exe} WORKING_DIRECTORY ${CMAKE_BINARY_DIR})
  set_tests_properties(${name} PROPERTIES LABELS "${labels}")
endfunction()
