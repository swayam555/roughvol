# Compilers come from the zig wrappers generated by build.sh in .toolchain/bin.
get_filename_component(_qc_bin "${CMAKE_CURRENT_LIST_DIR}/../.toolchain/bin" ABSOLUTE)
set(CMAKE_C_COMPILER   "${_qc_bin}/zig-cc")
set(CMAKE_CXX_COMPILER "${_qc_bin}/zig-c++")
set(CMAKE_AR           "${_qc_bin}/zig-ar" CACHE FILEPATH "ar")
set(CMAKE_RANLIB       "${_qc_bin}/zig-ranlib" CACHE FILEPATH "ranlib")
